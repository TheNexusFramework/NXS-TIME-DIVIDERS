// Slot 1
var box xray1_body = na
var line xray1_wick = na
var line xray1_eq = na

if xray1_en
    [o1, h1, l1, c1] = request.security(syminfo.tickerid, xray1_tf, [open, high, low, close], barmerge.gaps_off, barmerge.lookahead_off)
    tOpen1 = request.security(syminfo.tickerid, xray1_tf, time, barmerge.gaps_off, barmerge.lookahead_off)
    tClose1 = request.security(syminfo.tickerid, xray1_tf, time_close, barmerge.gaps_off, barmerge.lookahead_off)
    newHTF1 = ta.change(time(xray1_tf)) != 0
    
    top1 = math.max(o1, c1)
    bot1 = math.min(o1, c1)
    mid1 = (top1 + bot1) * 0.5
    midTime1 = (tOpen1 + tClose1) / 2
    bull1 = c1 >= o1
    
    if na(xray1_body) or newHTF1
        if not na(xray1_body)
            box.delete(xray1_body)
        if not na(xray1_wick)
            line.delete(xray1_wick)
        if not na(xray1_eq)
            line.delete(xray1_eq)
        
        xray1_body := box.new(tOpen1, top1, tClose1, bot1, xloc=xloc.bar_time, bgcolor=bull1 ? xray1_bullCol : xray1_bearCol, border_color=xray1_borderCol, border_width=1)
        if xray1_showWick
            xray1_wick := line.new(midTime1, h1, midTime1, l1, xloc=xloc.bar_time, color=xray1_wickCol, width=2)
        if xray1_showEQ
            xray1_eq := line.new(tOpen1, mid1, tClose1, mid1, xloc=xloc.bar_time, color=xray1_eqCol, style=line.style_dotted, width=1)
    else
        if not na(xray1_body)
            box.set_left(xray1_body, tOpen1), box.set_right(xray1_body, tClose1)
            box.set_top(xray1_body, top1), box.set_bottom(xray1_body, bot1)
            box.set_bgcolor(xray1_body, bull1 ? xray1_bullCol : xray1_bearCol)
        
        if xray1_showWick
            if na(xray1_wick)
                xray1_wick := line.new(midTime1, h1, midTime1, l1, xloc=xloc.bar_time, color=xray1_wickCol, width=2)
            else
                line.set_x1(xray1_wick, midTime1), line.set_x2(xray1_wick, midTime1)
                line.set_y1(xray1_wick, h1), line.set_y2(xray1_wick, l1)
        else if not na(xray1_wick)
            line.delete(xray1_wick)
            xray1_wick := na
        
