//@version=6
indicator("Time & Session Dividers - Enhanced", "NXS TIME DIVIDERS", overlay=true, max_lines_count=500, max_labels_count=500)

// === HELPER FUNCTIONS ===

// Function to format the timeframe string for the label
f_formatTimeframe(string timeframe) =>
    switch timeframe
        "1" => "1M"
        "3" => "3M"
        "5" => "5M"
        "15" => "15M"
        "30" => "30M"
        "60" => "1H"
        "120" => "2H"
        "180" => "3H"
        "240" => "4H"
        "D" => "1D"
        "W" => "1W"
        "M" => "1M"
        => timeframe

