// === TIMEFRAME DIVIDERS ===

// Get price range for full vertical lines
priceHigh = ta.highest(high, 500)
priceLow = ta.lowest(low, 500)

// --- Process Divider 1 (Timeframe) ---
if i_useDivider1
    var lineStyle1 = switch i_lineStyleStr1
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid
    
    tf_time1 = time(i_timeframe1)
    bool isNewTimeframeBar1 = ta.change(tf_time1) != 0
    
    // Historical dividers (within lookback)
    if isNewTimeframeBar1 and withinLookback
        line.new(bar_index, priceLow, bar_index, priceHigh, xloc.bar_index, extend.both, i_lineColor1, lineStyle1, i_lineWidth1)
        if i_showText1
            label.new(bar_index, high, f_formatTimeframe(i_timeframe1), xloc.bar_index, yloc.abovebar, 
                 color.new(color.white, 100), label.style_none, i_lineColor1, labelSizeValue)
    
    // Forward divider (forming candle close)
    if i_showForward and barstate.islast
        tClose1 = request.security(syminfo.tickerid, i_timeframe1, time_close, barmerge.gaps_off, barmerge.lookahead_off)
        var line forwardLine1 = na
        if not na(forwardLine1)
            line.delete(forwardLine1)
        forwardLine1 := line.new(tClose1, priceLow, tClose1, priceHigh, xloc.bar_time, extend.both, color.new(i_lineColor1, 50), lineStyle1, i_lineWidth1)

